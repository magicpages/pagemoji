{
  "name": "@magicpages/pagemoji",
  "version": "0.2.1",
  "description": "Emoji reactions for any web page. No cookies, no tracking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicpages/pagemoji.git",
    "directory": "packages/widget"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./pagemoji.js": "./dist/pagemoji.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
