{
  "name": "@magicpages/pagemoji-server",
  "version": "0.2.1",
  "description": "The Pagemoji server: emoji reaction counts, no personal data stored.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
